# Copy to apps/web/.env.local for local development. Never commit real values.
# Without the three required values the site runs in "not configured" mode.

# --- Web app (Firebase console > Project settings > Your apps > Web app) ---
VITE_FIREBASE_API_KEY=            # required
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=         # required
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=             # required

# App Check (reCAPTCHA v3 site key by default; set provider to recaptcha-enterprise to switch)
VITE_RECAPTCHA_SITE_KEY=
VITE_APPCHECK_PROVIDER=recaptcha-v3
# Local development only. Use "true" to have Firebase print a token, then register it
# in Firebase console > App Check > Apps > Manage debug tokens. Ignored in production builds.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud fallback model (default gemini-3.5-flash-lite)
VITE_CLOUD_MODEL=
# The Vercel API address (trap pages, canaries, runs). Local dev: http://localhost:3001
VITE_API_BASE=

# --- Vercel API (Vercel > Project > Settings > Environment Variables) ---
# The service-account JSON from Firebase console > Project settings > Service accounts.
# Paste the whole JSON, or base64 of it.
FIREBASE_SERVICE_ACCOUNT=
# Ed25519 private key for signing scorecards. Make it with `pnpm signing-key` (writes
# .secrets/tell-signing-key-v1.env, gitignored) and paste it into Vercel only. Key id k1.
TELL_SIGNING_KEY_V1=
# Salt for hashing IPs in rate-limit keys (any long random string). IPs are never stored.
TELL_HASH_SALT=
# App Check on run creation and reply checks: "enforce" once the reCAPTCHA key is live.
# Unset = monitor (a token that is sent must be valid; a missing one is allowed).
TELL_APPCHECK=
# Optional: the origin trap links use (defaults to the API's own origin)
TELL_TRAPS_BASE=
# Optional: extra web origins allowed to call the API (comma separated)
TELL_WEB_ORIGINS=
# LOCAL DEV ONLY: "memory" runs the API without Firebase. Refused on Vercel and in production.
TELL_DEV_STORE=
