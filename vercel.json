{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "echo 'Tell API: functions only, no static build'",
  "outputDirectory": "api-public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(t|c)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    },
    {
      "source": "/keys.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/keys.json",
      "destination": "/api/keys"
    },
    {
      "source": "/api/card/:id",
      "destination": "/api/card?id=:id"
    },
    {
      "source": "/t/:run/:trap",
      "destination": "/api/trap?run=:run&trap=:trap"
    },
    {
      "source": "/c/:run/:trap",
      "destination": "/api/canary?run=:run&trap=:trap"
    },
    {
      "source": "/api/run/:id/finish",
      "destination": "/api/run-finish?id=:id"
    },
    {
      "source": "/api/run/:id/reply",
      "destination": "/api/run-reply?id=:id"
    },
    {
      "source": "/api/run/:id",
      "destination": "/api/run-state?id=:id"
    }
  ]
}
