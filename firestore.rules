rules_version = '2';

// Tell v1 rules. Clients never write to Firestore: every write goes through
// the Vercel API with the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Runs and their hits are server-only. The live run page polls the API
    // (GET /api/run/{id}), which decides every card from these records, so
    // browsers never need to read them directly.
    match /runs/{runId} {
      allow read, write: if false;
      match /hits/{hitId} {
        allow read, write: if false;
      }
    }

    // Signed scorecards and the board are server-only too. Pages read them
    // through the API (GET /api/card/{id}, GET /api/board), which rate-limits
    // reads and never lists unlisted cards.
    match /cards/{cardId} {
      allow read, write: if false;
    }
    match /board/{entryId} {
      allow read, write: if false;
    }

    // Everything else (runSecrets, limits, ...) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
