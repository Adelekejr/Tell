rules_version = '2';

// Tell v1 rules. Clients never write to Firestore: every write goes through
// the Vercel API with the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Runs and their hits are server-only. The live run page polls the API
    // (GET /api/run/{id}), which decides every card from these records, so
    // browsers never need to read them directly.
    match /runs/{runId} {
      allow read, write: if false;
      match /hits/{hitId} {
        allow read, write: if false;
      }
    }

    // Signed scorecards: fetch one by id, never list them all.
    match /cards/{cardId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Opt-in leaderboard. Hidden entries are never readable.
    match /board/{entryId} {
      allow read: if resource.data.hidden == false;
      allow write: if false;
    }

    // Everything else (runSecrets, limits, ...) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
